# Copy to .env and fill in. Never commit .env.

# ── Public site ─────────────────────────────────────────
# Production only: your domain (DNS must point here). Caddy gets the HTTPS certificate automatically.
DOMAIN=
# Used in email links (password reset, order tracking).
APP_PUBLIC_URL=http://localhost:8081
WEB_PORT=8081

# ── Database ────────────────────────────────────────────
DB_USERNAME=giftgenius
DB_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me-too
BACKUP_KEEP_DAYS=14

# ── Auth ────────────────────────────────────────────────
# Generate with: openssl rand -base64 48
JWT_SECRET=
# Keep true. Browsers accept Secure cookies on http://localhost, so local Docker works too.
COOKIE_SECURE=true
COOKIE_SAME_SITE=Strict
# Only if the frontend is served from a different origin than the API (not needed with the included nginx).
CORS_ALLOWED_ORIGINS=

# Admin account, checked on every startup (password: 12+ characters):
#  - no account with ADMIN_EMAIL yet: an admin is created with ADMIN_PASSWORD;
#  - ADMIN_EMAIL already belongs to a customer (e.g. you signed up in the shop first): that account is
#    promoted to admin and its password becomes ADMIN_PASSWORD; its old sessions are signed out;
#  - already an admin: left unchanged (so a password you change later isn't reset on restart).
# Contact-form messages are also emailed to ADMIN_EMAIL.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# ── Email (order updates, password resets, contact form) ─
# Without SMTP_HOST nothing is sent: account emails are written to the backend log, and order emails are recorded
# as NOT_SENT in the email_outbox table. See docs/EMAIL_NOTIFICATIONS.md.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=GiftGenius <no-reply@example.com>
# A relay that takes no sign-in or no STARTTLS (for example a local test server): SMTP_AUTH=false, SMTP_STARTTLS=false.
# SMTP_AUTH=true
# SMTP_STARTTLS=true
# Who is emailed about each new order (customer name, email and city; no phone or street address). Comma-separated.
# Empty: ADMIN_EMAIL.
NOTIFY_ADMIN_EMAILS=
# The time zone order emails show times in.
# MAIL_TIME_ZONE=Asia/Kolkata
# Order emails are queued once with the order and delivered in the background (bounded retries; not exactly-once,
# see docs/EMAIL_NOTIFICATIONS.md#delivery-guarantee).
# MAIL_OUTBOX_SENDER_ENABLED=true
# MAIL_OUTBOX_POLL_INTERVAL=15s

# ── AI gift advisor ─────────────────────────────────────
# https://aistudio.google.com/apikey . Without a key, the rule-based engine answers.
AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Cost safeguard: model calls per day before the rules answer instead, and the pause after a quota error.
AI_DAILY_CALL_LIMIT=500
AI_QUOTA_COOLDOWN=5m

# ── Payments ────────────────────────────────────────────
# https://dashboard.razorpay.com (use rzp_test_ keys first). Off = cash on delivery only.
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Limits ──────────────────────────────────────────────
# Rate limits are per client address. It is read from X-Forwarded-For only when the request comes from a trusted proxy
# (private and loopback addresses by default). If your host's proxy connects from another range, name it here (a regex):
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10\.\d{1,3}\.\d{1,3}\.\d{1,3}
RATE_LIMIT_AI=10
RATE_LIMIT_AUTH=20
RATE_LIMIT_PUBLIC=30
PENDING_PAYMENT_TTL=30m
MAX_PENDING_ORDERS=3

# ── Checkout "Use my current location" ─────────────────
# Address lookup through OpenStreetMap Nominatim (free, no key; at most 1 request/second; results cached).
# GEO_ENABLED=false turns lookups off: the button then asks shoppers to type their address.
GEO_ENABLED=true
# Optional: another Nominatim-compatible provider, or a User-Agent naming your site (default: "GiftGenius (+APP_PUBLIC_URL)").
# GEOCODER_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODER_USER_AGENT=

# Swagger UI at /swagger-ui.html. Leave off in production.
API_DOCS_ENABLED=false

# ── Monitoring (management port, MANAGEMENT_PORT=9091 by default, never published) ─
# Liveness and readiness (/actuator/health/liveness, /actuator/health/readiness) are open, status only; Docker's
# health check uses readiness. Prometheus metrics (/actuator/prometheus) and the overall health need this token as
# "Authorization: Bearer <token>". Empty: metrics are refused to everyone. Use a long random value, for example
# openssl rand -hex 32, and give it only to your Prometheus scraper.
METRICS_SCRAPE_TOKEN=
# Optional, on a single-container host where nothing scrapes from another container (for example Railway):
# listen on the container's loopback only. Leave unset with Docker Compose if Prometheus scrapes over the network.
# MANAGEMENT_SERVER_ADDRESS=127.0.0.1
